{
  "name": "music-radar",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Track new and upcoming releases, concerts and news for your favorite artists",
  "scripts": {
    "dev": "mkdir -p dist && concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "db:migrate:local": "wrangler d1 migrations apply music-radar --local",
    "db:migrate": "wrangler d1 migrations apply music-radar --remote",
    "typecheck": "wrangler types && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "import-local": "node scripts/export-local.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.150.0"
  }
}
