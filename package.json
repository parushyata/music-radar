{
  "name": "music-radar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Track new and upcoming releases, concerts and news for your favorite artists",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production node server/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
